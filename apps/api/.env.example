# auth-engine API — copy to .env.local
# cp .env.example .env.local
#
# Matches repo-root docker-compose.yml (localhost ports).

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME=AuthEngine
APP_VERSION=1.0.0
APP_DESCRIPTION=AuthEngine IAM API
DEBUG=True
API_V1_PREFIX=/api/v1
APP_URL=http://localhost:8000

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
SECRET_KEY=change-me-min-32-chars-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OIDC_PRIVATE_KEY_PATH=./oidc_private.pem

# ─────────────────────────────────────────────
# Databases
# ─────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://authengine:authengine_local_pass@localhost:5432/authengine
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_SSL=False

MONGODB_URL=mongodb://admin:admin_local_pass@localhost:27017/authengine?authSource=admin
MONGODB_DB_NAME=authengine

REDIS_URL=redis://:redis_local_pass@localhost:6379/0
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET_KEY=change-me-min-32-chars-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ISSUER=authengine
JWT_AUDIENCE=authengine-api

# ─────────────────────────────────────────────
# Sessions, rate limiting, AWS
# ─────────────────────────────────────────────
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT_MINUTES=60
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=10
AWS_REGION=ap-south-1

# ─────────────────────────────────────────────
# WebAuthn / CORS
# ─────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
CORS_ORIGINS=["http://localhost:3000"]

# ─────────────────────────────────────────────
# Seed (`auth-engine seed`) — password stays here, profile in data/super_admin.json
# ─────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeThisStrongPassword123!

# Optional platform-tenant email / SMS / OAuth (used by `auth-engine seed platform-config`)
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_API_KEY=re_...
# EMAIL_SENDER=noreply@authengine.org
# SMS_PROVIDER=android_gateway
# SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
# SMS_GATEWAY_USERNAME=
# SMS_GATEWAY_PASSWORD=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# AUTHENGINE_BASE_URL=http://localhost:8000
# AUTHENGINE_CLIENT_ID=
# AUTHENGINE_CLIENT_SECRET=
# AUTHENGINE_REDIRECT_URI=http://localhost:3000/oauth/authengine/callback
